{
  "description": "mawred.rule/v1 parity: dates",
  "context": {
    "field": {
      "amount": 250,
      "amountText": "250",
      "days": 3,
      "reason": "Family trip",
      "type": "annual",
      "empty": "",
      "blank": "   ",
      "tags": [
        "urgent",
        "travel"
      ],
      "none": null,
      "range": {
        "from": "2026-03-18",
        "to": "2026-03-24"
      },
      "lines": [
        10,
        20.5,
        "x"
      ],
      "agree": true
    },
    "requester": {
      "branch": "01RUH",
      "gender": "female",
      "grade": "G5"
    },
    "ctx": {
      "today": "2026-10-15",
      "calendar": {
        "weekend": [
          5,
          6
        ],
        "holidays": [
          "2026-03-22"
        ]
      },
      "balances": {
        "ANNUAL": 12.5
      }
    }
  },
  "cases": [
    {
      "name": "days between",
      "rule": {
        "op": "days_between",
        "args": [
          {
            "ref": "field.range.from"
          },
          {
            "ref": "field.range.to"
          }
        ]
      },
      "expected": 6
    },
    {
      "name": "days between reversed",
      "rule": {
        "op": "days_between",
        "args": [
          "2026-03-24",
          "2026-03-18"
        ]
      },
      "expected": -6
    },
    {
      "name": "days between leap",
      "rule": {
        "op": "days_between",
        "args": [
          "2028-02-28",
          "2028-03-01"
        ]
      },
      "expected": 2
    },
    {
      "name": "days between invalid",
      "rule": {
        "op": "days_between",
        "args": [
          "2026-02-30",
          "2026-03-01"
        ]
      },
      "expected": null
    },
    {
      "name": "days between not date",
      "rule": {
        "op": "days_between",
        "args": [
          "tomorrow",
          "2026-03-01"
        ]
      },
      "expected": null
    },
    {
      "name": "working days",
      "rule": {
        "op": "working_days_between",
        "args": [
          {
            "ref": "field.range.from"
          },
          {
            "ref": "field.range.to"
          }
        ]
      },
      "expected": 4
    },
    {
      "name": "working days single",
      "rule": {
        "op": "working_days_between",
        "args": [
          "2026-03-19",
          "2026-03-19"
        ]
      },
      "expected": 1
    },
    {
      "name": "working days weekend only",
      "rule": {
        "op": "working_days_between",
        "args": [
          "2026-03-20",
          "2026-03-21"
        ]
      },
      "expected": 0
    },
    {
      "name": "working days reversed",
      "rule": {
        "op": "working_days_between",
        "args": [
          "2026-03-24",
          "2026-03-18"
        ]
      },
      "expected": 0
    },
    {
      "name": "working days no calendar",
      "rule": {
        "op": "working_days_between",
        "args": [
          "2026-03-16",
          "2026-03-22"
        ]
      },
      "expected": 7,
      "context": {
        "field": {},
        "ctx": {}
      }
    },
    {
      "name": "balance",
      "rule": {
        "op": "balance",
        "args": [
          "ANNUAL"
        ]
      },
      "expected": 12.5
    },
    {
      "name": "balance missing",
      "rule": {
        "op": "balance",
        "args": [
          "SICK"
        ]
      },
      "expected": null
    },
    {
      "name": "leave rule",
      "rule": {
        "op": "all",
        "args": [
          {
            "op": "lte",
            "args": [
              {
                "op": "working_days_between",
                "args": [
                  {
                    "ref": "field.range.from"
                  },
                  {
                    "ref": "field.range.to"
                  }
                ]
              },
              {
                "op": "balance",
                "args": [
                  "ANNUAL"
                ]
              }
            ]
          },
          {
            "op": "gte",
            "args": [
              {
                "ref": "field.range.from"
              },
              "2026-01-01"
            ]
          }
        ]
      },
      "expected": true
    }
  ]
}