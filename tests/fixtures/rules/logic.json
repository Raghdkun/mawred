          }
        ]
      },
      "expected": true
    },
    {
      "name": "any none",
      "rule": {
        "op": "any",
        "args": [
          false,
          null
        ]
      },
      "expected": false
    },
    {
      "name": "not empty list",
      "rule": {
        "op": "not",
        "args": [
          {
            "value": []
          }
        ]
      },
      "expected": true
    },
    {
      "name": "not empty object",
      "rule": {
