    {
      "name": "if true",
      "rule": {
        "op": "if",
        "args": [
          {
            "ref": "field.agree"
          },
          "yes",
          {
            "op": "nope",
            "args": [
              1
            ]
          }
        ]
      },
      "expected": "yes"
    },
    {
      "name": "if false",
      "rule": {
        "op": "if",
        "args": [
          {
            "ref": "field.none"
          },
          1,
          2
        ]
      },
      "expected": 2
