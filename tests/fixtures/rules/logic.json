    {
      "name": "ref missing",
      "rule": {
        "ref": "field.missing.deep"
      },
      "expected": null
    },
    {
      "name": "ref nested",
      "rule": {
        "ref": "field.range.from"
      },
      "expected": "2026-03-18"
