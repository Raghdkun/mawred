# Production environment for /core/mawred/.env.production (chmod 600, owned by the deploy user).
# Complete on its own: `deploy/make-env.sh <app-host>` copies it with the hosts filled in and the
# secrets generated on the server; then fill in mail, alerts and the backup bucket. Never commit
# the real file; keep a copy in the company password manager (APP_KEY, BLIND_INDEX_KEY and
# BACKUP_ARCHIVE_PASSWORD are needed to read any backup). Go-live: deploy/go-live-checklist.md.

APP_NAME=Mawred
APP_ENV=production
APP_DEBUG=false
APP_URL=https://hr.example.com
APP_KEY=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
# Keys the HMAC of exact-match lookups on encrypted fields (at least 32 characters, never changed).
BLIND_INDEX_KEY=
# D126: the real domain goes here, and in DNS (A/AAAA records to the server). deploy/nginx-site.sh
# builds the nginx site and gets a Let's Encrypt certificate for each host; ACME_EMAIL receives
# Let's Encrypt's expiry notices. Leave CAREERS_HOST or GLITCHTIP_HOST empty to skip that host;
# careers then stays at /careers on APP_HOST (CAREERS_ON_OWN_HOST=false, D87).
APP_HOST=hr.example.com
CAREERS_HOST=careers.example.com
CAREERS_ON_OWN_HOST=false
ACME_EMAIL=it@example.com
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Sessions, cache, queues and broadcasting all run on Redis and Reverb.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
REDIS_CLIENT=phpredis
REDIS_PASSWORD=null

# Content-Security-Policy (Phase 9a).
CSP_ENABLED=true
CSP_CONNECT_SRC=https://tiles.openfreemap.org
CSP_REPORT_URI=/hooks/csp-report

# Services on the Compose network.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=mawred
DB_USERNAME=mawred
DB_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
GOTENBERG_URL=http://gotenberg:3000
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
INERTIA_SSR_URL=http://ssr:13714
# The app publishes to Reverb on the private network; browsers come in through nginx (/app/).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_BROWSER_HOST=hr.example.com
REVERB_BROWSER_PORT=443
REVERB_BROWSER_SCHEME=https

# Loopback ports nginx proxies to (D134). Change them only if something else on the server uses them.
MAWRED_BLUE_PORT=8081
MAWRED_GREEN_PORT=8082
MAWRED_REVERB_PORT=8090
MAWRED_GLITCHTIP_PORT=8070

# Postmark (D127): SMTP or API credentials, and the From address on the verified domain.
MAIL_MAILER=smtp
MAIL_HOST=smtp.postmarkapp.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hr@example.com
MAIL_FROM_NAME=Mawred
WHATSAPP_GRAPH_VERSION=v25.0

# Unofficial WhatsApp (WAHA, D31): the API key the waha container requires. Enter the same value
# in Integrations → WhatsApp → Unofficial (WAHA) with the URL http://waha:3000.
WAHA_API_KEY=

# Web push (D128): php artisan mawred:vapid-keys, once.
VAPID_SUBJECT=mailto:hr@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Server alerts (deploy/monitor.sh, backup.sh, restore-drill.sh, spatie backup failures).
OPS_ALERT_EMAILS=it@example.com

# Backups (D15, D130). The archive password encrypts every archive (AES-256): lose it and the
# backups are unreadable. The S3 key may only write (no delete, no read); the read key for
# restores lives in the password manager, not here.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_LOCAL_MAX_MB=20000
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# A heartbeat URL (healthchecks.io style): pinged after each offsite copy, <url>/fail on failure.
BACKUP_HEARTBEAT_URL=

# Error tracking (D21, D131): GlitchTip on its own host. Create the project in GlitchTip, then
# use the internal DSN form http://<key>@glitchtip:8000/<project id> so events stay on the box.
GLITCHTIP_HOST=errors.example.com
GLITCHTIP_SECRET_KEY=
GLITCHTIP_EMAIL_URL=smtp://<postmark token>:<postmark token>@smtp.postmarkapp.com:587
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
