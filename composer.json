{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mawred/mawred",
    "type": "project",
    "description": "Mawred — internal HR, hiring & workflow platform.",
    "keywords": [
        "hr",
        "laravel"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "altcha-org/altcha": "^2.3",
        "dedoc/scramble": "^0.13.47",
        "gotenberg/gotenberg-php": "^2.25",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/horizon": "^5.50",
        "laravel/pennant": "^1.26",
        "laravel/pulse": "^1.8",
        "laravel/reverb": "^1.12",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "openspout/openspout": "^5.12",
        "propaganistas/laravel-phone": "^6.1",
        "sentry/sentry-laravel": "^4.29",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-query-builder": "^7.3",
        "spatie/laravel-translatable": "^6.14",
        "spatie/laravel-typescript-transformer": "^3.3"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel-lang/common": "^6.8",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-browser": "^5.1",
        "pestphp/pest-plugin-drift": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "rector/rector": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "pnpm install",
            "pnpm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "rector process --no-progress-bar",
            "pint --parallel"
        ],
        "lint:check": [
            "rector process --dry-run --no-progress-bar",
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@lint:check",
            "@analyse",
            "@test"
        ],
        "types:check": [
            "@analyse"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test --parallel --testsuite=Unit,Feature,Arch"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "analyse": [
            "phpstan analyse --memory-limit=1G --no-progress"
        ],
        "test:browser": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php artisan test --testsuite=Browser"
        ],
        "test:performance": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php artisan test --testsuite=Performance"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
