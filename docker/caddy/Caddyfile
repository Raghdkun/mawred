# Edge proxy (ADR-0017): automatic Let's Encrypt, WebSockets to Reverb, health-checked upstreams
# so a deploy can run two `app` containers side by side (ADR-0019).
{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static private_ranges
	}
}

(app_upstream) {
	reverse_proxy {
		dynamic a app 8080 {
			refresh 1s
		}
		lb_policy round_robin
		lb_try_duration 15s
		health_uri /up
		health_interval 5s
		health_timeout 3s
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
		# The app sends a Content-Security-Policy with frame-ancestors 'self' (CV previews frame same-origin).
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
}

{$APP_HOST} {
	encode zstd gzip
	import security_headers
	request_body {
		max_size 25MB
	}

	@reverb path /app/* /apps/*
	handle @reverb {
		reverse_proxy reverb:8080
	}

	handle {
		import app_upstream
	}
}

# Public careers site (D11): same app, separate host; session cookies stay on APP_HOST.
{$CAREERS_HOST} {
	encode zstd gzip
	import security_headers
	import app_upstream
}

# Error tracking (GlitchTip, D21): its own host, so its cookies and pages stay apart from Mawred's.
{$GLITCHTIP_HOST} {
	encode zstd gzip
	import security_headers
	request_body {
		max_size 20MB
	}
	reverse_proxy glitchtip:8000
}
