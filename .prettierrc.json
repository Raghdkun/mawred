{
    "printWidth": 100,
    "tabWidth": 4,
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all",
    "plugins": ["prettier-plugin-tailwindcss"],
    "tailwindStylesheet": "./resources/css/app.css",
    "tailwindFunctions": ["clsx", "cn", "cva"],
    "overrides": [{ "files": ["*.json", "*.yml", "*.yaml"], "options": { "tabWidth": 2 } }]
}
