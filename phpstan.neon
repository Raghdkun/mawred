includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # ADR: Larastan at the highest level; a committed baseline may only shrink.
    level: max

    tmpDir: storage/framework/cache/phpstan
