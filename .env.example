APP_NAME=Mawred
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5442
DB_DATABASE=mawred
DB_USERNAME=mawred
DB_PASSWORD=secret
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6389
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@mawred.test"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp Cloud API version (credentials live in the vault, ADR-0015)
WHATSAPP_GRAPH_VERSION=v25.0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Mawred
# Required: 64 hex chars (openssl rand -hex 32). Never rotate without re-indexing employees.
BLIND_INDEX_KEY=
GOTENBERG_URL=http://127.0.0.1:3001
APP_HOST=hr.mawred.test
CAREERS_HOST=careers.mawred.test
# Serve /careers on CAREERS_HOST instead of the app host (D87).
CAREERS_ON_OWN_HOST=false
# Inertia SSR server (production: http://ssr:13714, the `ssr` Compose service).
INERTIA_SSR_URL=http://127.0.0.1:13714

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8090
REVERB_SERVER_PORT=8090
REVERB_SCHEME=http

# Browsers read Reverb's address from the page (config mawred.realtime); set REVERB_BROWSER_* when
# it differs from where the app publishes (production: deploy/env.production.example).

# Local only: shared password for DemoSeeder sign-ins (12+ characters)
DEMO_PASSWORD=

# Upload scanning (optional): `docker compose --profile clamav up -d`, then set CLAMAV_HOST=127.0.0.1
CLAMAV_HOST=
CLAMAV_PORT=3310

# Web push (D128): generate once with `php artisan mawred:vapid-keys`; changing them later means
# every device turns push on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:${MAIL_FROM_ADDRESS}"

# Content-Security-Policy (Phase 9a): extra connect-src origins (comma-separated) and where
# browsers report violations (the app's own endpoint, or a GlitchTip security endpoint).
CSP_ENABLED=true
CSP_CONNECT_SRC=https://tiles.openfreemap.org
CSP_REPORT_URI=/hooks/csp-report

# Production only (deploy/env.production.example has the full list): error tracking through
# GlitchTip (D21), server alerts, and the password that encrypts backup archives.
SENTRY_LARAVEL_DSN=
OPS_ALERT_EMAILS=
BACKUP_ARCHIVE_PASSWORD=
